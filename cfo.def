Bootstrap: docker
From: python:3.12-slim

%labels
    Author Esther
    Description JAX/Flax container for CFO code

%files
    requirements.txt /opt/requirements.txt

%post
    python -m pip install --no-cache-dir --upgrade pip
    python -m pip install --no-cache-dir -r /opt/requirements.txt

%environment
    export PYTHONUNBUFFERED=1
    export XLA_PYTHON_CLIENT_PREALLOCATE=false
    export TF_CPP_MIN_LOG_LEVEL=2

%test
    python -c "import jax, flax, optax, orbax.checkpoint, h5py, tensorflow as tf; print(jax.__version__, jax.devices())"

%runscript
    exec python "$@"